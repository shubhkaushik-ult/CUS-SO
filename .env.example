# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Copy this file to .env and fill in your values
# ==============================================================================

# --- Application & Server Settings ---
PORT=5000
FLASK_ENV=production
FLASK_DEBUG=False
SECRET_KEY=your-secret-key-here

# --- MySQL Database Configuration ---
DB_HOST=nbs.ninjacart.in
DB_PORT=6033
DB_USER=your_db_username
DB_PASSWORD=your_db_password
DB_DATABASE=cyclops

# --- Google Sheets & Service Account Credentials ---
ECOM_SO_CREDENTIALS_PATH=ecom-so-reader-credetials.json
XD_ALLOCATION_CREDENTIALS_PATH=xd-allocation-9640b0ce66d2.json

# Raw JSON contents (Optional: for Railway / Vercel cloud env vars)
# ECOM_SO_CREDENTIALS_JSON=
# XD_ALLOCATION_CREDENTIALS_JSON=

# --- gRPC Service & Tunnel Settings ---
GRPC_PORT=50051
NGROK_AUTHTOKEN=your_ngrok_authtoken_here
